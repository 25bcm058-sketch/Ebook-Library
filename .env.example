# Copy to .env and fill in before `docker compose up -d`.
# Generate secrets with: openssl rand -hex 32

# Public hostname (https:// → automatic Let's Encrypt via Caddy)
PUBLIC_URL=https://books.example.com

# Used for Let's Encrypt expiry notices and the metadata-fetcher User-Agent
ADMIN_EMAIL=you@example.com

# PostgreSQL
POSTGRES_PASSWORD=change-me

# Seals TOTP secrets, OIDC client secrets, SMTP/Kindle credentials (AES-256-GCM).
# Back this up securely — losing it means users must re-enroll 2FA.
SHELFMARK_MASTER_KEY=change-me

# Shared secret between web and worker services
WORKER_JWT_SECRET=change-me

# Restic backup encryption password + repository (local path or s3:/rest: URL)
RESTIC_PASSWORD=change-me
BACKUP_REPO=./backups
